# Copy this file to .env and fill in your keys.
# NewsAPI key — get one free at https://newsapi.org/register
NEWSAPI_KEY="pastekeyhere"

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY="pastekeyhere"

# Secret for signing JWT login tokens. Use a long random string in production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET="dev-insecure-change-me"

# Email delivery (optional). Transport is picked in this order:
#   1. RESEND_API_KEY set -> Resend HTTP API. Use this in production / on hosts
#      that block SMTP (Render, etc.). Get a key at https://resend.com.
#      On Resend's free tier (no custom domain) you can only send to your own
#      account email, and the sender stays onboarding@resend.dev. Verify a domain
#      and set RESEND_FROM to send from your own address / to anyone.
#   2. SMTP_HOST set -> SMTP (great for local dev with a Gmail App Password).
#   3. neither -> dev mode: writes each email to backend/outbox/ as .html.
RESEND_API_KEY=""
# RESEND_FROM="Newsletter <news@yourdomain.com>"   # only after verifying a domain

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Newsletter Generator <no-reply@example.com>"
