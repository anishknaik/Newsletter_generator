# Copy this file to .env and fill in your keys.
# NewsAPI key — get one free at https://newsapi.org/register
NEWSAPI_KEY="pastekeyhere"

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY="pastekeyhere"

# Secret for signing JWT login tokens. Use a long random string in production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET="dev-insecure-change-me"

# Email delivery (optional). If SMTP_HOST is left blank, the app runs in
# "dev mode" and writes each email to backend/outbox/ instead of sending.
# For real sending with Gmail, create an App Password and use:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=app-password
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Newsletter Generator <no-reply@example.com>"
